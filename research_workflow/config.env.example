# Copy to research_workflow/config.env and fill the empty credential values.
# Do not commit config.env or paste its contents into chat.

# Select exactly one provider for both Alpha generation and research decisions.
# OpenAI: LLM_PROVIDER=openai, LLM_MODEL=gpt-6.1-sol
# DeepSeek: LLM_PROVIDER=deepseek, LLM_MODEL=deepseek-flash
LLM_PROVIDER=openai
LLM_MODEL=gpt-6.1-sol
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com
# Third-party OpenAI-compatible example:
# LLM_BASE_URL=https://www.jiji.cc/v1
# LLM_API_FORMAT=chat_completions
# LLM_DISABLE_RESPONSE_STORAGE=true
# For Responses API instead, use LLM_API_FORMAT=responses.
LLM_API_FORMAT=responses
LLM_JSON_MODE=auto
LLM_DISABLE_RESPONSE_STORAGE=false
# Editable prompt files. Defaults are research_workflow/prompts/*.txt.
# Changes to these files take effect on the next model call.
# LLM_GENERATE_PROMPT_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/prompts/generate.txt
# LLM_DECIDE_PROMPT_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/prompts/decide.txt
# LLM_PROBE_PROMPT_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/prompts/probe.txt
# LLM_PARAMETER_PROMPT_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/prompts/parameter_decide.txt
# LLM_SUBMISSION_PROMPT_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/prompts/select_submission.txt
# New autonomous hierarchy prompt overrides:
# LLM_TOPIC_PROMPT_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/prompts/research_topic.txt
# LLM_DIRECTIONS_PROMPT_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/prompts/research_directions.txt
# LLM_FEEDBACK_PROMPT_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/prompts/research_feedback.txt
# LLM_VARIANTS_PROMPT_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/prompts/alpha_variants.txt
# LLM_REPAIR_PROMPT_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/prompts/alpha_repair.txt
# LLM_BRAINSTORM_PROMPT_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/prompts/topic_brainstorm.txt

WQ_BRAIN_EMAIL=
WQ_BRAIN_PASSWORD=
WQ_REGION=USA
WQ_UNIVERSE=TOP3000
WQ_DELAY=1
WQ_NEUTRALIZATION=SUBINDUSTRY

# 1 allows one formal submission per Beijing day; 0 only records suggestions.
WQ_AUTO_SUBMIT=1

ALPHA_BATCH_SIZE=3
ALPHA_MAX_SIMULATIONS_DAY=20
ALPHA_MAX_CONCURRENT_SIMULATIONS=3
ALPHA_MAX_PENDING=30
ALPHA_SHARPE_GATE=1.2
ALPHA_MAX_COMBINATION_PAIRS=2
ALPHA_COMBINATION_WEIGHTS=0.25,0.5,0.75
ALPHA_FAMILY_MAX_STAGNANT=5
ALPHA_MAX_DIRECTIONS_TOPIC=3
ALPHA_MAX_EXPERIMENTS_DIRECTION=8
ALPHA_MAX_REPAIR_ATTEMPTS=2
ALPHA_MAX_INVALID_GENERATIONS=3
ALPHA_MAX_EXPERIMENT_CANDIDATES=24
ALPHA_SUBMISSION_REVIEW_LIMIT=30
ALPHA_MAX_ROUNDS=0
ALPHA_IDLE_SECONDS=30
ALPHA_LOG_LEVEL=INFO
# Base path: each launch writes workflow_<start time>_<pid>.log (10 MB per file, 5 backups).
# ALPHA_LOG_FILE=D:/Project/QR/WorldQuant-Alpha/research_workflow/logs/workflow.log
# Optional; blank uses a target-derived research objective and starter direction.
ALPHA_OBJECTIVE=
ALPHA_DIRECTION=

# Optional QuantGPT local prefilter. Empty means BRAIN-only simulation.
QUANTGPT_URL=
QUANTGPT_UNIVERSE=hs300
QUANTGPT_MIN_SCORE=0
